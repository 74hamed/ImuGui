<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Test classes are not a documented public API surface. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImuGui.Core\ImuGui.Core.csproj" />
  </ItemGroup>

  <!-- The bundled replay sample doubles as the integration-test fixture. -->
  <ItemGroup>
    <Content Include="..\..\samples\imu-sample.csv" Link="samples\imu-sample.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
